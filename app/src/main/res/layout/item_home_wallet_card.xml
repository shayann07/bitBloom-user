<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:backgroundTint="@android:color/transparent"
    card_view:strokeColor="@android:color/transparent"
    card_view:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/purble_bg"
        android:padding="18dp">

        <ImageView
            android:id="@+id/chip"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_chip"
            android:backgroundTint="@android:color/darker_gray"
            android:background="@drawable/chip_bg"/>

        <!-- Wallet Type -->
        <TextView
            android:id="@+id/tvWalletType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Wi-Fi & Toggle Icons -->
        <ImageView
            android:id="@+id/iconToggle"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:src="@drawable/wifi" />


        <!-- Provider Name -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvWalletType"
            android:layout_marginTop="32dp"
            android:text="Name"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvName"
            android:layout_marginTop="24dp"
            android:text="200"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="12dp"
            android:padding="4dp"
            android:src="@drawable/mastercard"
            android:translationY="-12dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>