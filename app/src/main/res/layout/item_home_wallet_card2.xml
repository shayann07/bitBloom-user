<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <!-- 1) LinearLayout wraps both sections -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glassy_bg_gradient"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <!-- 2) Balance section ("balance card") -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glassy_bg_gradient2"
                android:padding="20dp">

                <!-- Top row: My Balance + Account details > -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="My Balance"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:drawableEnd="@drawable/ic_arrow_right"
                    android:drawablePadding="4dp"
                    android:text="My Team"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvTitle"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Balance + badge -->
                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvBalance"
                    app:layout_constraintStart_toEndOf="@id/tvBalance" />

                <!-- Buttons row -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvest"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Invest"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#1F1F1F"
                    app:cornerRadius="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBalance"
                    app:layout_constraintWidth_percent="0.48" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTransactions"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Transactions"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBalance"
                    app:layout_constraintWidth_percent="0.48" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3) Bottom link section -->
        <LinearLayout
            android:id="@+id/annoucementsNavigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLinkPre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get some Extraduid"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="4dp"
                android:text="Bitbloom Plan Presentation PDF"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/ic_arrow_right2" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
