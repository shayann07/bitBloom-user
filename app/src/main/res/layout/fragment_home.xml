<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top Bar with Profile Title and Icons -->
                <RelativeLayout
                    android:id="@+id/topbar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/menuIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_menu" />

                    <TextView
                        android:id="@+id/profileTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Home"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/notificationIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/gift" />
                </RelativeLayout>

                <FrameLayout
                    android:id="@+id/greetingTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp">

                    <TextView
                        android:id="@+id/greetingTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp">

                    <!-- Wallet Card -->
                    <include
                        android:id="@+id/walletCard"
                        layout="@layout/item_home_wallet_card2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:background="@drawable/glassy_bg_gradient2"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top row: icon, label, referral code, copy button -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <!-- Icon box -->
                        <ImageView
                            android:id="@+id/iconRef"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_referral_icon"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_user_add" />

                        <!-- Referral Code Label and Number -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/iconRef"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:text="Refferel Code"
                                android:textColor="#EDEDED"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/textReferralCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:text=""
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Copy Code -->
                        <LinearLayout
                            android:id="@+id/copyCodeLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copy Code"
                                android:textColor="#DDDDDD"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_copy" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Input with right-end icon -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_referral"
                        android:gravity="center_vertical|center_horizontal"
                        android:paddingEnd="12dp">

                        <EditText
                            android:id="@+id/inputReferral"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@android:color/transparent"
                            android:drawableEnd="@drawable/ic_link"
                            android:editable="false"
                            android:paddingVertical="9dp"
                            android:paddingStart="14dp"
                            android:text=""
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/imgAnnouncementPager"
                    android:layout_width="match_parent"
                    android:layout_height="146dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/featuresTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Features"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:id="@+id/featuresGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:rowCount="2">

                    <!-- Feature 1: My Team -->
                    <LinearLayout
                        android:id="@+id/teamScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_my_team" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Achievements"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/leaderBoardScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_leaderboard" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Leaderboard"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/dashboardScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_dashboard" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Dashboard"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/announcementScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_announcements" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Announcements"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/luckySpinScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lucky_spin"
                            app:tint="@android:color/holo_blue_bright" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Lucky Spin"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/txnScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_transactions" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Transactions"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/salaryScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_exchange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Salary"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/dailyRewardsScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_daily_rewards" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Daily Rewards"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Feature 2: Leaderboard -->
                    <LinearLayout
                        android:id="@+id/supportScreenBtn"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/glassy_bg_gradient2"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_support" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Support"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </GridLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />

            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>