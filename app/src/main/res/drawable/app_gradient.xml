<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="640dp"
    android:viewportWidth="360"
    android:viewportHeight="640">

    <!-- Full‐screen rectangle with square corners -->
    <path android:pathData="M0,0 L360,0 L360,640 L0,640 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="360"
                android:endY="640"
                android:startX="0"
                android:startY="0"
                android:tileMode="clamp"
                android:type="linear">

                <item
                    android:color="#FF2F64C9"
                    android:offset="0.00" />
                <item
                    android:color="#FF3366C0"
                    android:offset="0.10" />
                <item
                    android:color="#FF2944A2"
                    android:offset="0.25" />
                <item
                    android:color="#FF1F1056"
                    android:offset="0.40" />
                <item
                    android:color="#FF211D68"
                    android:offset="0.60" />
                <item
                    android:color="#FF1B0041"
                    android:offset="0.80" />
                <item
                    android:color="#FF1B0041"
                    android:offset="1.00" />

            </gradient>
        </aapt:attr>
    </path>
</vector>
